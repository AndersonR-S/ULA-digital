module ULA_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLOCK;
reg [31:0] DATA_MEM_IN;
reg LOADN;
reg [7:0] PROG_MEM_IN;
// wires                                               
wire [31:0] A_BUS;
wire [31:0] B_BUS;
wire [31:0] C_BUS;
wire DATA_MEM_write_enable;
wire [31:0] DATA_MEN_ADDR;
wire [31:0] DATA_MEN_OUT;
wire [7:0] MBR_OUT;
wire [35:0] MIR;
wire [8:0] MPC;
wire [31:0] PC;

wire sampler;                             

// assign statements (if any)                          
ULA i1 (
// port map - connection between master ports and signals/registers   
	.A_BUS(A_BUS),
	.B_BUS(B_BUS),
	.C_BUS(C_BUS),
	.CLOCK(CLOCK),
	.DATA_MEM_IN(DATA_MEM_IN),
	.DATA_MEM_write_enable(DATA_MEM_write_enable),
	.DATA_MEN_ADDR(DATA_MEN_ADDR),
	.DATA_MEN_OUT(DATA_MEN_OUT),
	.LOADN(LOADN),
	.MBR_OUT(MBR_OUT),
	.MIR(MIR),
	.MPC(MPC),
	.PC(PC),
	.PROG_MEM_IN(PROG_MEM_IN)
);

// CLOCK
always
begin
	CLOCK = 1'b0;
	CLOCK = #80000 1'b1;
	#20000;
end 

// LOADN
initial
begin
	LOADN = 1'b1;
	LOADN = #10000 1'b0;
end 
// PROG_MEM_IN[ 7 ]
initial
begin
	PROG_MEM_IN[7] = 1'b1;
	PROG_MEM_IN[7] = #620000 1'b0;
end 
